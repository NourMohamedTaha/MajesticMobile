<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MajesticMobile.Models"
             x:Class="MajesticMobile.InvoicesHistoryPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#0B131D"
             Title="سجل الفواتير">

    <Grid RowDefinitions="Auto, *" Padding="15" RowSpacing="15">

        <!-- شريط البحث -->
        <Frame Grid.Row="0" BackgroundColor="#162130" Padding="15,0" CornerRadius="12" BorderColor="#2C3E50" HeightRequest="50" HasShadow="True">
            <Entry x:Name="searchBar" Placeholder="🔍 بحث برقم الفاتورة أو اسم العميل..." BackgroundColor="Transparent" TextColor="White" PlaceholderColor="#7F8C8D" TextChanged="OnSearchTextChanged" />
        </Frame>

        <!-- قائمة الفواتير مع ميزة السحب للتحديث -->
        <RefreshView Grid.Row="1" x:Name="refreshViewInvoices" Refreshing="OnRefreshRequested" RefreshColor="#3498DB">
            <CollectionView x:Name="cvInvoices">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Padding="20" Spacing="15">
                        <Label Text="🧾" FontSize="60" HorizontalOptions="Center" Opacity="0.5"/>
                        <Label Text="لا توجد فواتير مسجلة حتى الآن." TextColor="#7F8C8D" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InvoiceModel">
                        <Frame BackgroundColor="#162130" Margin="0,0,0,10" Padding="15" BorderColor="#2C3E50" CornerRadius="12" HasShadow="True">
                            <VerticalStackLayout Spacing="8">

                                <!-- الصف الأول: رقم الفاتورة والتاريخ -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding InvoiceNumber}" TextColor="#3498DB" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding InvoiceDate, StringFormat='{0:yyyy/MM/dd hh:mm tt}'}" TextColor="#95A5A6" FontSize="11" VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#2C3E50" Margin="0,2"/>

                                <!-- الصف الثاني: اسم العميل -->
                                <Label Text="{Binding CustomerName}" TextColor="White" FontSize="16" FontAttributes="Bold" />

                                <!-- الصف الثالث: طريقة الدفع والمبلغ الصافي -->
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                        <Label Text="طريقة الدفع:" TextColor="#7F8C8D" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding PaymentMethod}" TextColor="#F39C12" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding NetAmount, StringFormat='{0:N2} ج.م'}" TextColor="#2ECC71" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>