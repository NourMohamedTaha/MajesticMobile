<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MajesticMobile.CustomerDetailPage"
             Title="ملف العميل وكشف الحساب"
             FlowDirection="RightToLeft"
             BackgroundColor="#0B131D">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="15" Spacing="15">

            <Frame BackgroundColor="#162130" CornerRadius="12" Padding="20" BorderColor="#2C3E50" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label x:Name="lblCustomerName" Text="---" TextColor="White" FontSize="20" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                <Label x:Name="lblCustomerPhone" Text="---" TextColor="#95A5A6" FontSize="14" />
                                <Label x:Name="lblCustomerRegion" Text="📍 ---" TextColor="#3498DB" FontSize="13" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="إجمالي المديونية" TextColor="#7F8C8D" FontSize="12" HorizontalOptions="End" />
                            <Label x:Name="lblCurrentBalance" Text="0.00 ج.م" TextColor="#E74C3C" FontSize="22" FontAttributes="Bold" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Button Grid.Column="0" Text="تعديل 📝" BackgroundColor="#3498DB" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Clicked="OnEditClicked" />
                <Button Grid.Column="1" x:Name="btnDelete" Text="حذف 🗑️" BackgroundColor="#E74C3C" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Clicked="OnDeleteClicked" />
            </Grid>

            <Frame BackgroundColor="#1F2E40" CornerRadius="12" Padding="15" BorderColor="#3498DB" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="سداد دفعة من المديونية 💰" TextColor="White" FontAttributes="Bold" FontSize="15" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" x:Name="entryPaymentAmount" Placeholder="المبلغ..." Keyboard="Numeric" BackgroundColor="#0B131D" TextColor="White" PlaceholderColor="#7F8C8D" />
                        <Button Grid.Column="1" x:Name="btnPay" Text="تأكيد ✔" BackgroundColor="#27AE60" TextColor="White" FontAttributes="Bold" CornerRadius="10" WidthRequest="100" Clicked="OnPayClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="سجل كشف الحساب 🧾" TextColor="WhiteSmoke" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="refreshViewLedger" Refreshing="OnRefreshLedgerRefreshing" RefreshColor="#3498DB" Margin="15,0,15,15">
            <CollectionView x:Name="cvLedger">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Label Text="لا توجد حركات مسجلة لهذا العميل." TextColor="#7F8C8D" HorizontalOptions="Center" FontSize="15" />
                        <Label Text="اسحب للأسفل لتحديث السجل." TextColor="#95A5A6" HorizontalOptions="Center" FontSize="12" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#162130" Margin="0,0,0,10" Padding="15" BorderColor="#2C3E50" CornerRadius="10">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Description}" TextColor="White" FontSize="14" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding TransDate, StringFormat='{0:yyyy/MM/dd hh:mm tt}'}" TextColor="#95A5A6" FontSize="12" Margin="0,5,0,0" />

                                <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Debit, StringFormat='عليه: {0:N2}'}" IsVisible="{Binding HasDebit}" TextColor="#E74C3C" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                                    <Label Text="{Binding Credit, StringFormat='سدد: {0:N2}'}" IsVisible="{Binding HasCredit}" TextColor="#2ECC71" FontSize="12" FontAttributes="Bold" HorizontalOptions="End"/>
                                    <BoxView HeightRequest="1" BackgroundColor="#34495E" Margin="0,2" IsVisible="{Binding HasDebit}"/>
                                    <Label Text="{Binding RunningBalance, StringFormat='رصيد: {0:N2}'}" TextColor="#3498DB" FontSize="13" FontAttributes="Bold" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>