<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MajesticMobile.TreasuryPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#0B131D"
             Title="الخزنة والمصروفات">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="10" ColumnSpacing="5">
            <Button x:Name="btnTabDaily" Grid.Column="0" Text="تقفيل اليومية 📝" BackgroundColor="#3498DB" TextColor="White" FontAttributes="Bold" Clicked="OnTabClicked" CommandParameter="Daily"/>
            <Button x:Name="btnTabMonthly" Grid.Column="1" Text="التقفيل الشهري 🏦" BackgroundColor="#162130" TextColor="White" FontAttributes="Bold" Clicked="OnTabClicked" CommandParameter="Monthly"/>
        </Grid>

        <!-- ========================================== -->
        <!-- 1. شاشة (اليومية المفتوحة) -->
        <!-- ========================================== -->
        <RefreshView Grid.Row="1" x:Name="refreshViewDaily" Refreshing="OnRefreshRequested" RefreshColor="#3498DB">
            <ScrollView x:Name="viewDaily" IsVisible="True">
                <VerticalStackLayout Padding="10" Spacing="10">

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="8" RowSpacing="8">

                        <!-- الصف الأول -->
                        <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="إجمالي البيع اليوم" TextColor="#3498DB" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyTotalSales" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="مبيعات (كاش)" TextColor="#2ECC71" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyCash" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- الصف الثاني -->
                        <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="إنستاباي الكردي" TextColor="#1ABC9C" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyInstaKurdi" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="إنستاباي الحكش" TextColor="#9B59B6" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyInstaHakosh" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- الصف الثالث -->
                        <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="آجل للشركة" TextColor="#F39C12" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyCredit" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="2" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="مرتجعات (-)" TextColor="#E74C3C" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyReturns" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- الصف الرابع -->
                        <Frame Grid.Row="3" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="مصروفات (-)" TextColor="#E74C3C" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyExpenses" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="3" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="سلف (-)" TextColor="#E67E22" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblDailyAdvances" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>

                    <Frame BackgroundColor="#2980B9" CornerRadius="10" BorderColor="Transparent" Padding="15" Margin="0,5">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="صافي النقدية بالدرج الآن:" TextColor="#ECF0F1" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label x:Name="lblExpectedCash" Grid.Column="1" Text="0.00" TextColor="White" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <BoxView HeightRequest="1" Color="#2C3E50" Margin="0,5"/>

                    <Label Text="تسجيل منصرف جديد 💸" TextColor="White" FontSize="16" FontAttributes="Bold" />

                    <Frame BackgroundColor="#1F2E40" BorderColor="#3498DB" CornerRadius="10" Padding="15">
                        <VerticalStackLayout Spacing="10">

                            <!-- أزرار اختيار نوع المعاملة -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button x:Name="btnTypeExpense" Grid.Column="0" Text="مصروفات" BackgroundColor="#E74C3C" TextColor="White" FontAttributes="Bold" CornerRadius="8" Clicked="OnTransTypeClicked" CommandParameter="Expense"/>
                                <Button x:Name="btnTypeAdvance" Grid.Column="1" Text="سلفة" BackgroundColor="#162130" TextColor="#BDC3C7" FontAttributes="Bold" CornerRadius="8" Clicked="OnTransTypeClicked" CommandParameter="Advance"/>
                            </Grid>

                            <Entry x:Name="entryExpenseAmount" Placeholder="المبلغ (ج.م)" Keyboard="Numeric" TextColor="White" BackgroundColor="#0B131D" PlaceholderColor="#7F8C8D" />
                            <Entry x:Name="entryExpenseNotes" Placeholder="ملاحظات والتفاصيل..." TextColor="White" BackgroundColor="#0B131D" PlaceholderColor="#7F8C8D" />
                            <Button Text="حفظ واعتماد 💾" BackgroundColor="#27AE60" TextColor="White" FontAttributes="Bold" CornerRadius="8" Clicked="OnSaveExpenseClicked"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Button Text="جرد وتقفيل الوردية 🔒" BackgroundColor="#E74C3C" TextColor="White" FontAttributes="Bold" HeightRequest="55" CornerRadius="10" Margin="0,10,0,20" Clicked="OnCloseShiftClicked"/>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ========================================== -->
        <!-- 2. شاشة (التقفيل الشهري) -->
        <!-- ========================================== -->
        <RefreshView Grid.Row="1" x:Name="refreshViewMonthly" Refreshing="OnRefreshRequested" RefreshColor="#3498DB" IsVisible="False">
            <ScrollView x:Name="viewMonthly" Padding="10">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="8" RowSpacing="8">

                        <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="إجمالي مبيعات الشهر" TextColor="#3498DB" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyTotalSales" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="مبيعات الشهر (كاش)" TextColor="#2ECC71" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyCash" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="إنستاباي الكردي" TextColor="#1ABC9C" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyInstaKurdi" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="إنستاباي الحكش" TextColor="#9B59B6" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyInstaHakosh" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="آجل للشركة" TextColor="#F39C12" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyCredit" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="2" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="مرتجعات الشهر (-)" TextColor="#E74C3C" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyReturns" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="3" Grid.Column="0" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="مصروفات الشهر (-)" TextColor="#E74C3C" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyExpenses" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="3" Grid.Column="1" BackgroundColor="#162130" CornerRadius="8" Padding="15" BorderColor="#2C3E50">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="سلف الشهر (-)" TextColor="#E67E22" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label x:Name="lblMonthlyAdvances" Text="0.00" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>

                    <Frame BackgroundColor="#27AE60" CornerRadius="10" BorderColor="Transparent" Padding="20" Margin="0,10,0,10">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="رصيد الكاش المتاح للترحيل للرئيسي" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="lblMonthlyAvailable" Text="0.00 ج.م" TextColor="White" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Button Text="توريد وتقفيل الشهر 🏦" BackgroundColor="#F39C12" TextColor="White" FontAttributes="Bold" HeightRequest="55" CornerRadius="10" Clicked="OnTransferToMainClicked"/>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>
</ContentPage>