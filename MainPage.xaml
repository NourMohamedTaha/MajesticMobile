<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MajesticMobile"
             xmlns:models="clr-namespace:MajesticMobile.Models"
             x:Class="MajesticMobile.MainPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#0F1722"
             Title="الرئيسية">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame x:Name="frmGreeting" BackgroundColor="#F1C40F" CornerRadius="10" Padding="15" BorderColor="Transparent" IsVisible="False" HasShadow="True">
                <Label Text="صلِّ على النبي محمد ﷺ" TextColor="#141E2A" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <!-- الهيدر: اسم الفرع وحالة الاتصال -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label x:Name="lblBranchName" Text="أهلاً بك، (جاري التحميل...)" TextColor="WhiteSmoke" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="lblDate" Text="تاريخ اليوم: ..." TextColor="#95a5a6" FontSize="14" Margin="0,5,0,0" />
                </VerticalStackLayout>
                <Frame x:Name="frmConnectionStatus" Grid.Column="1" BackgroundColor="#2ECC71" Padding="12,5" CornerRadius="8" HasShadow="False" VerticalOptions="Center">
                    <Label x:Name="lblConnectionStatus" Text="متصل 🟢" TextColor="White" FontSize="12" FontAttributes="Bold" />
                </Frame>
            </Grid>

            <!-- الإحصائيات (المبيعات، الخزنة، المرتجعات، الأوفلاين) -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1E2B3C" CornerRadius="10" BorderColor="Transparent" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="إجمالي المبيعات" TextColor="#2ECC71" FontSize="13" FontAttributes="Bold" />
                        <Label x:Name="lblSales" Text="0.00 ج.م" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1E2B3C" CornerRadius="10" BorderColor="Transparent" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="الكاش بالدرج" TextColor="#3498DB" FontSize="13" FontAttributes="Bold" />
                        <Label x:Name="lblCash" Text="0.00 ج.م" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1E2B3C" CornerRadius="10" BorderColor="Transparent" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="إجمالي المرتجعات" TextColor="#E74C3C" FontSize="13" FontAttributes="Bold" />
                        <Label x:Name="lblReturns" Text="0.00 ج.م" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#1E2B3C" CornerRadius="10" BorderColor="Transparent" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="فواتير معلقة (أوفلاين)" TextColor="#F1C40F" FontSize="13" FontAttributes="Bold" />
                        <Label x:Name="lblOfflineInvoices" Text="0 فاتورة" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- أزرار الإجراءات السريعة -->
            <Button Text="إصدار فاتورة بيع 🛒" BackgroundColor="#3498DB" TextColor="White" FontSize="18" FontAttributes="Bold" CornerRadius="10" HeightRequest="60" Margin="0,10,0,0" Clicked="OnNewSaleClicked"/>

            <Button x:Name="btnSync" Text="رفع البيانات للسيرفر 🔄" BackgroundColor="#E67E22" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Clicked="OnSyncClicked"/>

            <!-- الإشعارات -->
            <Label Text="الإشعارات والتنبيهات 🔔" TextColor="WhiteSmoke" FontSize="16" FontAttributes="Bold" Margin="0,15,0,5" />

            <Frame BackgroundColor="#1E2B3C" CornerRadius="10" BorderColor="Transparent" Padding="0" HasShadow="True">
                <CollectionView x:Name="cvNotifications" HeightRequest="200" Margin="10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationModel">
                            <Grid ColumnDefinitions="Auto, *" Padding="10" Margin="0,0,0,5">
                                <Label Grid.Column="0" Text="🔸" VerticalOptions="Center" Margin="0,0,10,0"/>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" TextColor="{Binding ColorCode}" FontSize="14" FontAttributes="Bold"/>
                                    <Label Text="{Binding Message}" TextColor="#bdc3c7" FontSize="12" Margin="0,2,0,0" />
                                    <Label Text="{Binding TimeAgo}" TextColor="#7f8c8d" FontSize="10" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="لا توجد إشعارات حالياً." TextColor="#7f8c8d" HorizontalOptions="Center" VerticalOptions="Center" Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>